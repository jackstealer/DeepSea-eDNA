[MASTER]
ignore=CVS,.git,__pycache__,build,dist
ignore-patterns=test_.*?py
jobs=4

[MESSAGES CONTROL]
disable=C0111,  # missing-docstring
        C0103,  # invalid-name
        R0903,  # too-few-public-methods
        R0913,  # too-many-arguments
        W0212,  # protected-access
        E1101   # no-member

[FORMAT]
max-line-length=120
indent-string='    '

[DESIGN]
max-args=10
max-locals=25
max-returns=8
max-branches=15
max-statements=60
max-attributes=12
